{
  "name": "@imagexmedia/eslint",
  "type": "module",
  "version": "0.0.3",
  "description": "The ImageX SWAT ESLint package.",
  "author": "ImageX Media",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "configs",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b && mkdir -p packs && npm pack --pack-destination packs"
