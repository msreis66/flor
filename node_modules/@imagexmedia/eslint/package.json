  "dependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@eslint-react/eslint-plugin": "^2.7.4",
    "@eslint/compat": "^2.0.1",
    "@prettier/plugin-xml": "^3.4.2",
    "deepmerge": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26"
  }
}
