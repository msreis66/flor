{
  "name": "@imagexmedia/vite",
  "type": "module",
  "version": "0.0.3",
  "description": "The ImageX SWAT Vite package.",
  "author": "ImageX Media",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./plugins/svg": {
      "types": "./dist/plugins/svg.d.ts",
      "default": "./dist/plugins/svg.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "configs",
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b && mkdir -p packs && npm pack --pack-destination packs"
  },
  "dependencies": {
    "@spiriit/vite-plugin-svg-spritemap": "^6.0.0",
    "sass-embedded": "^1.97.3",
    "svgo": "^4.0.0",
    "vite": "^7.3.1",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
