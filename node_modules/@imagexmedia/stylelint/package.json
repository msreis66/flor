{
  "name": "@imagexmedia/stylelint",
  "type": "module",
  "version": "0.0.3",
  "description": "The ImageX SWAT Stylelint package.",
  "author": "ImageX Media",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "configs",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b && mkdir -p packs && npm pack --pack-destination packs"
  },
  "peerDependencies": {
    "deepmerge": "^4.3.1",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-prettier": "^5.0.3"
  }
}
